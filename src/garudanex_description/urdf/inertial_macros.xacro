<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Inertia tensors for primitive shapes about their centre of mass.
       Must satisfy the triangle inequalities:
         ixx+iyy >= izz, iyy+izz >= ixx, izz+ixx >= iyy
       Gazebo warns and then misbehaves if they don't. -->

  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass/12.0)*(y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(mass/12.0)*(x*x + z*z)}" iyz="0.0"
        izz="${(mass/12.0)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass/12.0)*(3.0*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
        iyy="${(mass/12.0)*(3.0*radius*radius + length*length)}" iyz="0.0"
        izz="${(mass/2.0)*(radius*radius)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2.0/5.0)*mass*radius*radius}" ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0)*mass*radius*radius}" iyz="0.0"
        izz="${(2.0/5.0)*mass*radius*radius}"/>
    </inertial>
  </xacro:macro>
</robot>
