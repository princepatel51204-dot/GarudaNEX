<?xml version="1.0"?>
<package format="3">
  <name>garudanex_sim</name>
  <version>1.0.0</version>
  <description>
    Gazebo Harmonic worlds, models and ros_gz_bridge configuration for the
    GarudaNEX aerial platform. Bridges the simulation clock and 2D LiDAR
    from Gazebo Transport into the ROS 2 DDS graph.
  </description>
  <maintainer email="princepatel51204@gmail.com">Prince Patel</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
